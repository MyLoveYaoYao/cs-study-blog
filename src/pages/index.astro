---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title="首页">
  <section class="hero">
    <p class="eyebrow"><span class="eyebrow-dot"></span> 一个持续更新的学习角落</p>
    <h1>把学过的，<br /><span>一点点记下来。</span></h1>
    <p class="hero-copy">
      这里用来整理学习笔记、记录思考，也留住一路上的小小进步。慢慢来，持续写。
    </p>
    <a class="button button-primary" href={`${baseUrl}posts/`}>
      浏览文章 <span aria-hidden="true">→</span>
    </a>
    <div class="hero-decoration" aria-hidden="true">
      <span class="decoration-card card-back"></span>
      <span class="decoration-card card-front">
        <span class="decoration-line"></span>
        <span class="decoration-line short"></span>
        <span class="decoration-spark">✳</span>
      </span>
      <span class="decoration-dot"></span>
    </div>
  </section>

  <section class="section-block" aria-labelledby="latest-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">从这里开始</p>
        <h2 id="latest-heading">最近的记录</h2>
      </div>
      <a class="text-link" href={`${baseUrl}posts/`}>全部文章 <span aria-hidden="true">↗</span></a>
    </div>

    {posts.length > 0 ? (
      <div class="post-list">
        {posts.map((post) => (
          <a class="post-card" href={`${baseUrl}posts/${post.id}/`}>
            <div class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {dateFormatter.format(post.data.pubDate)}
              </time>
              {post.data.example && <span class="example-badge">示例</span>}
            </div>
            <div class="post-card-main">
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
            <span class="post-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>还没有文章。写下第一篇学习记录，它就会出现在这里。</p>
        <a class="text-link" href={`${baseUrl}about/`}>了解如何开始 <span aria-hidden="true">→</span></a>
      </div>
    )}
  </section>

  <section class="note-banner">
    <span class="note-icon" aria-hidden="true">✦</span>
    <p>不必一次学会所有东西，<strong>每天向前一点点</strong>就很好。</p>
  </section>
</BaseLayout>
