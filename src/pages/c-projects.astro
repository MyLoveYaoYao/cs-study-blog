---
import { cProjectStages } from "../data/c-projects";
import { cProjectSolutions } from "../data/c-project-solutions";
import BaseLayout from "../layouts/BaseLayout.astro";

const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const projectCount = cProjectStages.reduce((total, stage) => total + stage.projects.length, 0);
---

<BaseLayout title="C语言练习路线" description="循序渐进的 100 个 C 语言练手项目，每题包含任务要求和实现注释。">
  <section class="c-project-page">
    <header class="c-project-hero">
      <p class="eyebrow"><span class="eyebrow-dot"></span> 从第一行代码到综合应用</p>
      <h1>100 个 C 语言练手项目</h1>
      <p class="c-project-lede">
        按阶段一步步练习。遇到困难可先看提示；需要对照时，再查看仓库中的完整可编译 C 源码。
      </p>
      <div class="c-project-summary">
        <span><strong>{projectCount}</strong> 个项目</span>
        <span><strong>{cProjectStages.length}</strong> 个循序渐进阶段</span>
        <span><strong>{projectCount}</strong> 题配有提示与答案</span>
      </div>
    </header>

    <aside class="c-project-guide">
      <span class="c-guide-icon" aria-hidden="true">✦</span>
      <div>
        <strong>怎么使用这份练习路线</strong>
        <p>从第 1 题开始，先读要求并自己写程序。卡住时先展开“查看提示”；仍不清楚时再看“标准答案”，并进入仓库中的完整 C 源码。建议先独立尝试，再对照并亲手重新写一遍。</p>
      </div>
    </aside>

    <aside class="c-quickstart">
      <strong>第一次写 C 程序？</strong>
      <p>把代码存成 <code>main.c</code>。安装好 GCC 后，在终端运行 <code>gcc main.c -o main</code> 编译；Windows 运行 <code>.\main.exe</code>，macOS 或 Linux 运行 <code>./main</code>。如果终端提示找不到 gcc，先安装 C 编译器。</p>
    </aside>

    <nav class="c-stage-index" aria-label="练习阶段">
      {cProjectStages.map((stage, index) => (
        <a href={`#stage-${index + 1}`}>阶段 {index + 1}<span>{stage.projects.length} 题</span></a>
      ))}
    </nav>

    <div class="c-stage-list">
      {cProjectStages.map((stage, stageIndex) => (
        <section id={`stage-${stageIndex + 1}`} class="c-stage">
          <header class="c-stage-heading">
            <span class="c-stage-number">{String(stageIndex + 1).padStart(2, "0")}</span>
            <div>
              <p class="eyebrow">第 {stageIndex + 1} 阶段 · 项目 {stage.projects[0].id}–{stage.projects[stage.projects.length - 1].id}</p>
              <h2>{stage.title}</h2>
              <p>{stage.introduction}</p>
              <span class="c-stage-focus">练习重点：{stage.focus}</span>
            </div>
            <span class="c-stage-count">{stage.projects.length} 题</span>
          </header>

          <div class="c-project-list">
            {stage.projects.map((project) => (
              <details class="c-project">
                <summary>
                  <span class="c-project-number">{String(project.id).padStart(2, "0")}</span>
                  <span class="c-project-title">{project.title}</span>
                  <span class="c-project-toggle" aria-hidden="true">＋</span>
                </summary>
                <div class="c-project-body">
                  <div class="c-project-requirement">
                    <strong><span aria-hidden="true">▸</span> 任务要求</strong>
                    <p>{project.requirements}</p>
                  </div>
                  <div class="c-project-assistance">
                    <details class="c-assist-item c-assist-hint">
                      <summary><span>查看提示</span><span class="c-assist-toggle" aria-hidden="true">＋</span></summary>
                      <p>{project.note}</p>
                    </details>
                    <details class="c-assist-item c-assist-answer">
                      <summary><span>查看标准答案</span><span class="c-assist-toggle" aria-hidden="true">＋</span></summary>
                      <p>{cProjectSolutions[project.id]}</p>
                      <div class="c-source-links">
                        <a
                          href={`https://github.com/MyLoveYaoYao/cs-study-blog/blob/main/solutions/${String(project.id).padStart(3, "0")}/main.c`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          查看完整 C 源码
                        </a>
                        <a
                          href={`https://raw.githubusercontent.com/MyLoveYaoYao/cs-study-blog/main/solutions/${String(project.id).padStart(3, "0")}/main.c`}
                          target="_blank"
                          rel="noopener noreferrer"
                        >
                          下载源码
                        </a>
                      </div>
                    </details>
                  </div>
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>

    <a class="c-project-back" href={baseUrl}><span aria-hidden="true">←</span> 返回博客首页</a>
  </section>
</BaseLayout>
